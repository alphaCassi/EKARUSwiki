# Copy to .env and fill in. Never commit the real .env.

# Long random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admins (comma-separated) and the password for the admin pages (asked once per browser,
# remembered 30 days). Choose a long password.
ADMIN_EMAILS=oleksandra.rebrysh@inaf.it
# If the password contains $ put it in single quotes, e.g. ADMIN_PASSWORD='my$pass',
# otherwise Docker may change it. Spaces or quotes around the value are removed.
ADMIN_PASSWORD=

# Public https address of this server (used in e-mail links), and of the published wiki
BASE_URL=https://ekaruswiki.example.org
WIKI_URL=https://alphacassi.github.io/EKARUSwiki/

# Outgoing mail. Leave SMTP_HOST empty to save e-mails in instance/outbox/ instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
MAIL_FROM=EKARUSwiki <no-reply@example.org>

# Wiki integration (admin pages "Wiki users" and "Wiki home page", contact form)
# GITHUB_TOKEN: fine-grained token, repository EKARUSwiki only, permission "Contents: Read and write".
GITHUB_REPO=alphaCassi/EKARUSwiki
GITHUB_BRANCH=main
GITHUB_TOKEN=
# Extra sites allowed to send the contact form besides WIKI_URL (comma-separated), e.g. for local tests:
CORS_ORIGINS=
# 1 when running behind nginx, Docker + Tailscale Funnel, or a Cloudflare tunnel
PROXY_FIX=1

# Keep 1 in production (cookies only over https). Set 0 only for a local http trial.
SESSION_COOKIE_SECURE=1
